---
import Icon from './Icon.astro';
import Button from './Button.astro';

const words = ['Convertimos', 'tu', 'presencia', 'digital', 'en'];

const chips = [
	{ icon: 'search', label: 'SEO' },
	{ icon: 'megaphone', label: 'Ads' },
	{ icon: 'pen-tool', label: 'Branding' }
];
---

<section id="inicio" class="relative overflow-hidden">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div
			class="absolute -top-40 right-[-12%] h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle_at_center,var(--color-primary-500),transparent_65%)] opacity-[0.16] blur-3xl animate-glow-pulse"
		></div>
		<div
			class="absolute bottom-[-30%] left-[-10%] h-[28rem] w-[28rem] rounded-full bg-[radial-gradient(circle_at_center,var(--color-secondary-500),transparent_65%)] opacity-[0.12] blur-3xl animate-drift"
		></div>
		<div
			class="absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,black,transparent)] bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:44px_44px]"
		></div>
	</div>

	<div
		class="relative mx-auto grid max-w-6xl gap-14 px-5 pb-20 pt-36 sm:px-8 md:pt-44 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-12 lg:pb-28"
	>
		<div>
			<div data-reveal>
				<span
					class="inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-medium text-text-2"
				>
					<span class="relative flex h-2 w-2" aria-hidden="true">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-secondary-400 opacity-60"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-secondary-400"></span>
					</span>
					Agencia de marketing digital
				</span>
			</div>

			<h1
				class="mt-7 font-display text-[2.6rem] font-bold leading-[1.06] tracking-tight text-text sm:text-6xl xl:text-[4.6rem]"
			>
				{
					words.map((word, i) => (
						<span
							class="hero-word mr-[0.28em]"
							style={`--word-delay: ${150 + i * 90}ms`}
						>
							{word}
						</span>
					))
				}
				<span
					class="hero-word inline-block bg-gradient-to-r from-primary-400 to-primary-300 bg-clip-text text-transparent"
					style="--word-delay: 650ms"
				>
					crecimiento real.
				</span>
			</h1>

			<p
				class="mt-6 max-w-md text-base leading-relaxed text-text-2 sm:text-lg"
				data-reveal
				style="--reveal-delay: 800ms"
			>
				Estrategia, SEO, publicidad y desarrollo web. Menos ruido, más resultados.
			</p>

			<div
				class="mt-9 flex flex-wrap items-center gap-4"
				data-reveal
				style="--reveal-delay: 950ms"
			>
				<Button href="#contacto" size="lg" arrow>Hablemos</Button>
				<Button href="#servicios" variant="secondary" size="lg">Conócenos</Button>
			</div>
		</div>

		<div
			class="relative mx-auto w-full max-w-md lg:max-w-none"
			data-reveal="zoom"
			style="--reveal-delay: 300ms"
		>
			<div class="parallax-slow relative aspect-square" aria-hidden="true">
				<div
					class="absolute inset-0 rounded-full border border-dashed border-border-strong animate-spin-slow"
				></div>
				<div
					class="absolute inset-[8%] rounded-full border border-border bg-[radial-gradient(circle_at_30%_25%,var(--color-surface-2),var(--color-bg)_70%)]"
				></div>
				<div
					class="absolute inset-[22%] rounded-full border border-border-strong bg-[radial-gradient(circle_at_60%_40%,var(--color-secondary-500),transparent_70%)] opacity-[0.1]"
				></div>
				<div
					class="absolute inset-[30%] rounded-full border border-border bg-[radial-gradient(circle_at_center,var(--color-primary-500),transparent_75%)] opacity-[0.14] animate-glow-pulse"
				></div>
				<div class="absolute inset-[44%] rounded-full bg-primary-500/90 shadow-[0_0_60px_-8px_var(--color-primary-500)]"></div>

				<div
					class="absolute left-[4%] top-[16%] flex animate-float items-center gap-2.5 rounded-xl border border-border bg-surface px-4 py-3 shadow-lg"
				>
					<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary-500/10 text-secondary-400">
						<Icon name={chips[0].icon} size={18} />
					</span>
					<span class="text-sm font-semibold text-text">{chips[0].label}</span>
				</div>

				<div
					class="absolute right-0 top-[38%] flex animate-float-soft items-center gap-2.5 rounded-xl border border-border bg-surface px-4 py-3 shadow-lg"
					style="animation-delay: 1.2s"
				>
					<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-500/10 text-primary-400">
						<Icon name={chips[1].icon} size={18} />
					</span>
					<span class="text-sm font-semibold text-text">{chips[1].label}</span>
				</div>

				<div
					class="absolute bottom-[12%] left-[10%] flex animate-float items-center gap-2.5 rounded-xl border border-border bg-surface px-4 py-3 shadow-lg"
					style="animation-delay: 2.1s"
				>
					<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-500/10 text-gold-400">
						<Icon name={chips[2].icon} size={18} />
					</span>
					<span class="text-sm font-semibold text-text">{chips[2].label}</span>
				</div>
			</div>
		</div>
	</div>
</section>
