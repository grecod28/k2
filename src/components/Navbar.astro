---
import Icon from './Icon.astro';
import Button from './Button.astro';

const links = [
	{ label: 'Servicios', href: '#servicios' },
	{ label: 'Equipo', href: '#equipo' },
	{ label: 'Proceso', href: '#proceso' },
	{ label: 'Por qué nosotros', href: '#por-que' },
	{ label: 'Contacto', href: '#contacto' }
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md">
	<nav
		class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8 md:h-20"
		aria-label="Navegación principal"
	>
		<a href="#inicio" class="flex shrink-0 items-center gap-3">
			<img
				src="/images/k2_studio_logo.jpg"
				alt=""
				width="32"
				height="32"
				class="h-8 w-8 rounded-lg object-cover"
			/>
			<span class="font-display text-lg font-bold tracking-tight text-text">K2 Studio</span>
		</a>

		<ul class="hidden items-center gap-9 md:flex">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="relative py-2 text-sm font-medium text-text-2 transition-colors duration-200 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-primary-500 after:transition-transform after:duration-300 hover:text-text hover:after:scale-x-100"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden md:block">
			<Button href="#contacto" arrow>Hablemos</Button>
		</div>

		<button
			id="menu-toggle"
			type="button"
			class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface text-text transition-colors hover:border-border-strong md:hidden"
			aria-expanded="false"
			aria-controls="menu-movil"
			aria-label="Abrir menú"
		>
			<Icon name="menu" size={22} class="menu-icon" />
			<Icon name="x" size={22} class="menu-icon-close hidden" />
		</button>
	</nav>

	<div id="menu-movil" hidden class="border-t border-border bg-bg/95 backdrop-blur-md md:hidden">
		<ul class="space-y-1 px-5 py-4">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="block rounded-lg px-4 py-3 text-base font-medium text-text-2 transition-colors hover:bg-surface hover:text-text"
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="pt-3">
				<Button href="#contacto" arrow class="w-full">Hablemos</Button>
			</li>
		</ul>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('menu-movil');
	const menuIcon = toggle?.querySelector('.menu-icon');
	const closeIcon = toggle?.querySelector('.menu-icon-close');

	function setMenu(open) {
		if (!toggle || !menu) return;
		menu.hidden = !open;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		menuIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
	}

	toggle?.addEventListener('click', () => {
		setMenu(menu?.hidden ?? true);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenu(false));
	});
</script>
