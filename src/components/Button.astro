---
import Icon from './Icon.astro';

interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit';
	arrow?: boolean;
	class?: string;
	id?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	arrow = false,
	class: className,
	id
} = Astro.props;

const base =
	'inline-flex items-center justify-center gap-2 rounded-full font-semibold tracking-tight transition-all duration-300 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-60';

const sizes = {
	md: 'px-6 py-2.5 text-sm',
	lg: 'px-8 py-3.5 text-base'
};

const variants = {
	primary:
		'bg-primary-500 text-bg hover:bg-primary-400 hover:shadow-[0_0_28px_-6px_var(--color-primary-500)] active:scale-[0.98]',
	secondary:
		'border border-border-strong bg-surface text-text hover:border-primary-500 hover:text-primary-300 active:scale-[0.98]',
	ghost: 'text-text-2 hover:text-text'
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
	href ? (
		<a href={href} class={`group ${classes}`}>
			<span class="relative z-10">
				<slot />
			</span>
			{
				arrow && (
					<Icon
						name="arrow-right"
						size={size === 'lg' ? 20 : 18}
						class="relative z-10 transition-transform duration-300 group-hover:translate-x-1"
					/>
				)
			}
		</a>
	) : (
		<button type={type} class={classes} id={id}>
			<span class="relative z-10">
				<slot />
			</span>
			{
				arrow && (
					<Icon
						name="arrow-right"
						size={size === 'lg' ? 20 : 18}
						class="relative z-10 transition-transform duration-300 group-hover:translate-x-1"
					/>
				)
			}
		</button>
	)
}
