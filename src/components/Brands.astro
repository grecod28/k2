---
import Icon from "./Icon.astro";

interface Brand {
  name: string;
  sector: string;
  description: string;
  tags: string[];
  logo: string;
  accent: string;
  glow: string;
}

const brands: Brand[] = [
  {
    name: "Todomovil",
    sector: "Telefonía",
    description:
      "Tienda online, identidad y contenido para una firma que quería dejar de depender del escaparate físico.",
    tags: ["Web | SEO", "Branding", "Contenido"],
    logo: `<path d="M6 27a14 14 0 0 1 28 0"/><path d="M3 31h34"/><circle cx="20" cy="11" r="2.4" fill="currentColor" stroke="none"/>`,
    accent: "text-accent-300 bg-accent-500/10 border-accent-500/30",
    glow: "hover:shadow-[0_30px_80px_-50px_var(--color-accent-400)]",
  },
  {
    name: "Nordika",
    sector: "Interiorismo",
    description:
      "Identidad visual y web para un estudio que necesitaba transmitir su forma de trabajar antes de la primera visita.",
    tags: ["Identidad", "Diseño web", "SEO"],
    logo: `<path d="M9 31V9l22 22V9"/><path d="M9 31h22"/>`,
    accent: "text-secondary-300 bg-secondary-500/10 border-secondary-500/30",
    glow: "hover:shadow-[0_30px_80px_-50px_var(--color-secondary-400)]",
  },
];
---

<section id="marcas" class="relative overflow-hidden py-20 lg:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,var(--color-primary-500),transparent_70%)] opacity-[0.08] blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Confianza</p>
      <h2 class="section-title mt-4 font-display text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
        Marcas que trabajan
        <span class="text-gradient">con nosotros</span>
      </h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-text-2 sm:text-lg">
        Negocios con identidad propia que quieren crecer sin perder lo que les
        hace diferentes.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {brands.map((brand, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <article
            class={`spotlight card-ring group relative flex h-full min-h-[17rem] flex-col overflow-hidden rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-border-strong ${brand.glow}`}
          >
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
              aria-hidden="true"
            ></span>
            <div
              class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-[radial-gradient(circle_at_center,var(--color-surface-2),transparent_70%)] opacity-70"
              aria-hidden="true"
            ></div>

            <div class="flex items-start justify-between gap-4">
              <span
                class={`flex h-14 w-14 items-center justify-center rounded-2xl border ${brand.accent}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="30"
                  height="30"
                  viewBox="0 0 40 40"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={brand.logo}
                />
              </span>
              <span
                class="font-display text-sm font-semibold tracking-widest text-text-3"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <h3 class="mt-6 font-display text-xl font-bold tracking-tight text-text">
              {brand.name}
            </h3>
            <p class="mt-1 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-text-3">
              {brand.sector}
            </p>

            <p class="mt-4 flex-1 text-sm leading-relaxed text-text-2">
              {brand.description}
            </p>

            <ul class="mt-6 flex flex-wrap gap-2 border-t border-border/80 pt-4">
              {brand.tags.map((tag) => (
                <li class="rounded-full border border-border bg-surface-2 px-2.5 py-1 text-[0.7rem] font-medium text-text-2">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}

      <li data-reveal style="--reveal-delay: 200ms" class="sm:col-span-2 lg:col-span-1">
        <a
          href="#contacto"
          class="group spotlight relative flex h-full min-h-[17rem] flex-col justify-between overflow-hidden rounded-2xl border border-primary-500/40 bg-gradient-to-br from-primary-500/15 via-surface to-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary-500/70 hover:shadow-[0_30px_80px_-50px_var(--color-primary-500)]"
        >
          <span
            class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/70 to-transparent"
            aria-hidden="true"
          ></span>
          <div
            class="pointer-events-none absolute -right-12 -top-12 h-36 w-36 rounded-full bg-[radial-gradient(circle_at_center,var(--color-primary-500),transparent_70%)] opacity-20 blur-2xl"
            aria-hidden="true"
          ></div>

          <div>
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-500/40 bg-primary-500/10 text-primary-400">
              <Icon name="arrow-up-right" size={26} />
            </span>
            <h3 class="mt-6 font-display text-xl font-bold tracking-tight text-text">
              ¿Y tu marca?
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-2">
              Cuéntanos tu proyecto y te contamos cómo podemos ayudarte a
              crecer.
            </p>
          </div>

          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary-400 transition-colors group-hover:text-primary-300">
            Hablemos
            <Icon
              name="arrow-right"
              size={16}
              class="transition-transform duration-300 group-hover:translate-x-1"
            />
          </span>
        </a>
      </li>
    </ul>

    <p
      class="mt-8 text-center text-xs uppercase tracking-[0.18em] text-text-3"
      data-reveal
    >
      Ejemplos de marcas y proyectos
    </p>
  </div>
</section>
