---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

const steps = [
  {
    number: "01",
    icon: "compass",
    title: "Descubrimos",
    description: "Analizamos tu negocio y tu mercado.",
  },
  {
    number: "02",
    icon: "pen-tool",
    title: "Diseñamos",
    description: "Estrategia clara, objetivos medibles.",
  },
  {
    number: "03",
    icon: "rocket",
    title: "Ejecutamos",
    description: "Cada canal, un mismo objetivo.",
  },
  {
    number: "04",
    icon: "refresh-cw",
    title: "Optimizamos",
    description: "Medimos, aprendemos, mejoramos.",
  },
];
---

<section
  id="proceso"
  class="relative border-y border-border bg-surface py-20 lg:py-28"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-64 w-[40rem] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,var(--color-secondary-500),transparent_70%)] opacity-[0.06] blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      eyebrow="Proceso"
      align="center"
      description="Simple, claro y medible."
    >
      Cómo <span class="text-gradient">trabajamos</span>
    </SectionHeading>

    <ol class="relative mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      <div
        class="absolute left-[12%] right-[12%] top-7 hidden h-px bg-gradient-to-r from-transparent via-border-strong to-transparent lg:block"
        aria-hidden="true"
      ></div>
      {steps.map((step, i) => (
        <li
          class="group relative"
          data-reveal
          style={`--reveal-delay: ${i * 110}ms`}
        >
          <div class="spotlight relative flex h-full flex-col items-start gap-5 rounded-2xl border border-transparent p-5 transition-all duration-300 hover:border-border hover:bg-bg/50 lg:items-center lg:text-center">
            <span
              class="pointer-events-none absolute right-4 top-3 font-display text-4xl font-bold tracking-tight text-white/[0.03]"
              aria-hidden="true"
            >
              {step.number}
            </span>

            <div class="relative flex h-14 w-14 items-center justify-center">
              <span
                class="absolute inset-0 rounded-full border border-border bg-bg transition-all duration-300 group-hover:border-primary-500/60 group-hover:shadow-[0_0_28px_-6px_var(--color-primary-500)]"
                aria-hidden="true"
              ></span>
              <span
                class="absolute -inset-1 rounded-full border border-dashed border-border/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              ></span>
              <Icon
                name={step.icon}
                size={22}
                class="relative text-primary-400 transition-transform duration-300 group-hover:scale-110"
              />
            </div>
            <div class="relative lg:px-2">
              <span
                class="font-display text-xs font-semibold tracking-[0.25em] text-primary-400/80"
                aria-hidden="true"
              >
                {step.number}
              </span>
              <h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-text">
                {step.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-text-2">
                {step.description}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
