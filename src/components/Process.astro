---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const steps = [
	{
		number: '01',
		icon: 'compass',
		title: 'Descubrimos',
		description: 'Analizamos tu negocio y tu mercado.'
	},
	{
		number: '02',
		icon: 'pen-tool',
		title: 'Diseñamos',
		description: 'Estrategia clara, objetivos medibles.'
	},
	{
		number: '03',
		icon: 'rocket',
		title: 'Ejecutamos',
		description: 'Cada canal, un mismo objetivo.'
	},
	{
		number: '04',
		icon: 'refresh-cw',
		title: 'Optimizamos',
		description: 'Medimos, aprendemos, mejoramos.'
	}
];
---

<section id="proceso" class="relative border-y border-border bg-surface py-20 lg:py-28">
	<div class="mx-auto max-w-6xl px-5 sm:px-8">
		<SectionHeading
			eyebrow="Proceso"
			align="center"
			description="Simple, claro y medible."
		>
			Cómo trabajamos
		</SectionHeading>

		<ol class="relative mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<div
				class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-border-strong to-transparent lg:block"
				aria-hidden="true"
			></div>
			{
				steps.map((step, i) => (
					<li
						class="group relative flex flex-col items-start gap-5 lg:items-center lg:text-center"
						data-reveal
						style={`--reveal-delay: ${i * 110}ms`}
					>
						<div class="relative flex h-14 w-14 items-center justify-center">
							<span
								class="absolute inset-0 rounded-full border border-border bg-bg transition-all duration-300 group-hover:border-primary-500/60 group-hover:shadow-[0_0_24px_-6px_var(--color-primary-500)]"
								aria-hidden="true"
							></span>
							<Icon
								name={step.icon}
								size={22}
								class="relative text-primary-400 transition-transform duration-300 group-hover:scale-110"
							/>
						</div>
						<div class="lg:px-2">
							<span
								class="font-display text-xs font-semibold tracking-[0.25em] text-text-3"
								aria-hidden="true"
							>
								{step.number}
							</span>
							<h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-text">
								{step.title}
							</h3>
							<p class="mt-1.5 text-sm text-text-2">
								{step.description}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
