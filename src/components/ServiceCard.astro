---
import ServiceCardContent from "./ServiceCardContent.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
  index?: string;
  delay?: number;
  featured?: boolean;
  href?: string;
}

const {
  icon,
  title,
  description,
  index,
  delay = 0,
  featured = false,
  href,
} = Astro.props;
---

{featured && href ? (
  <a
    href={href}
    class="group spotlight card-ring relative flex flex-col overflow-hidden rounded-2xl border border-primary-500/30 bg-gradient-to-br from-primary-500/10 via-surface to-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary-500/60 hover:shadow-[0_24px_60px_-32px_var(--color-primary-500)] lg:col-span-2"
    data-reveal
    style={`--reveal-delay: ${delay}ms`}
  >
    <span
      class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full bg-[radial-gradient(circle_at_center,var(--color-primary-500),transparent_70%)] opacity-20 blur-2xl"
      aria-hidden="true"
    ></span>
    <ServiceCardContent
      icon={icon}
      title={title}
      description={description}
      index={index}
      featured
    />
  </a>
) : (
  <article
    class="group spotlight relative flex flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-border-strong hover:bg-surface-2 hover:shadow-[0_24px_60px_-40px_rgb(0_0_0/1)]"
    data-reveal
    style={`--reveal-delay: ${delay}ms`}
  >
    <span
      class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-primary-500/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      aria-hidden="true"
    ></span>
    <ServiceCardContent
      icon={icon}
      title={title}
      description={description}
      index={index}
    />
  </article>
)}
