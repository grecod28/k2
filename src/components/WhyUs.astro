---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

const reasons = [
  {
    icon: "target",
    title: "Estrategias personalizadas",
    description: "Cada plan nace de tu negocio.",
  },
  {
    icon: "database",
    title: "Datos, no corazonadas",
    description: "Decisiones basadas en métricas.",
  },
  {
    icon: "message-circle",
    title: "Comunicación directa",
    description: "Hablas con quien ejecuta.",
  },
  {
    icon: "zap",
    title: "Orientación a resultados",
    description: "Trabajamos contra objetivos.",
  },
  {
    icon: "eye",
    title: "Transparencia total",
    description: "Siempre sabes qué hacemos.",
  },
];

const highlights = ["Equipo senior", "Sin permanencias", "Respuesta en 24h"];
---

<section id="por-que" class="relative overflow-hidden py-20 lg:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute right-[-10%] top-[10%] h-96 w-96 rounded-full bg-[radial-gradient(circle_at_center,var(--color-gold-500),transparent_70%)] opacity-[0.07] blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeading eyebrow="Por qué nosotros">
        No somos <span class="text-gradient">una agencia más</span>
      </SectionHeading>

      <p
        class="mt-5 max-w-md text-base leading-relaxed text-text-2"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        Somos el equipo que se implica como si el negocio fuera nuestro. Menos
        intermediarios, menos ruido y decisiones que se explican.
      </p>

      <div
        class="card-ring mt-8 rounded-2xl border border-border bg-surface p-5"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-text-3">
          Nuestra promesa
        </p>
        <ul class="mt-4 space-y-3">
          {highlights.map((item) => (
            <li class="flex items-center gap-3 text-sm font-medium text-text">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-secondary-500/10 text-secondary-400">
                <Icon name="check" size={14} />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="space-y-3">
      {reasons.map((reason, i) => (
        <li
          class="group spotlight relative flex items-start gap-5 rounded-2xl border border-border/60 bg-surface/40 p-5 transition-all duration-300 hover:border-border-strong hover:bg-surface"
          data-reveal
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-2 text-secondary-400 shadow-[inset_0_1px_0_0_rgb(255_255_255/0.05)] transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-secondary-500/40 group-hover:bg-secondary-500/10">
            <Icon name={reason.icon} size={20} />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-3">
              <span
                class="font-display text-[0.7rem] font-semibold tracking-[0.2em] text-text-3/70"
                aria-hidden="true"
              >
                0{i + 1}
              </span>
              <h3 class="font-display text-base font-semibold tracking-tight text-text">
                {reason.title}
              </h3>
            </div>
            <p class="mt-1 text-sm leading-relaxed text-text-2">
              {reason.description}
            </p>
          </div>
          <Icon
            name="arrow-up-right"
            size={16}
            class="mt-1 shrink-0 text-text-3 opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
