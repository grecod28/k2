---
import Button from './Button.astro';
import Marquee from './Marquee.astro';

const marqueeWords = ['Hablemos', 'K2 Studio', 'Tu marca', 'Resultados'];
---

<section class="relative overflow-hidden border-y border-border bg-surface">
	<div
		class="pointer-events-none absolute inset-0"
		aria-hidden="true"
	>
		<div
			class="absolute left-1/2 top-1/2 h-[24rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,var(--color-primary-500),transparent_65%)] opacity-[0.12] blur-3xl"
		></div>
		<div class="absolute inset-x-0 top-1/2 -translate-y-1/2 rotate-[-3deg] opacity-[0.05]">
			<Marquee items={marqueeWords} size="lg" outlined duration={36} />
		</div>
	</div>

	<div class="relative mx-auto max-w-4xl px-5 py-20 text-center sm:px-8 lg:py-28">
		<p
			class="text-xs font-semibold uppercase tracking-[0.22em] text-primary-400"
			data-reveal
		>
			¿Tienes un proyecto en mente?
		</p>
		<h2
			class="mt-5 font-display text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl lg:leading-[1.12]"
			data-reveal
			style="--reveal-delay: 100ms"
		>
			Hablemos.
		</h2>
		<p
			class="mx-auto mt-4 max-w-md text-base text-text-2 sm:text-lg"
			data-reveal
			style="--reveal-delay: 200ms"
		>
			Cuéntanos qué quieres conseguir. Sin compromiso.
		</p>
		<div
			class="mt-9 flex flex-wrap items-center justify-center gap-4"
			data-reveal
			style="--reveal-delay: 300ms"
		>
			<Button href="#contacto" size="lg" arrow>Solicita una consulta</Button>
		</div>
	</div>
</section>
