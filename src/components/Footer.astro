---
import Icon from './Icon.astro';

const navigation = [
	{ label: 'Inicio', href: '#inicio' },
	{ label: 'Servicios', href: '#servicios' },
	{ label: 'Proceso', href: '#proceso' },
	{ label: 'Por qué nosotros', href: '#por-que' },
	{ label: 'Contacto', href: '#contacto' }
];

const services = [
	'Estrategia digital',
	'SEO',
	'Publicidad online',
	'Social Media',
	'Branding',
	'Desarrollo web'
];

const socials = [
	{ icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/company/k2studio' },
	{ icon: 'instagram', label: 'Instagram', href: 'https://www.instagram.com/k2studio' },
	{ icon: 'twitter', label: 'X', href: 'https://x.com/k2studio' }
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
	<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
		<div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
			<div>
				<a href="#inicio" class="flex items-center gap-3">
					<img
						src="/images/k2_studio_logo.jpg"
						alt=""
						width="32"
						height="32"
						class="h-8 w-8 rounded-lg object-cover"
					/>
					<span class="font-display text-lg font-bold tracking-tight text-text">
						K2 Studio
					</span>
				</a>
				<p class="mt-5 max-w-xs text-sm leading-relaxed text-text-2">
					Agencia de marketing digital. Estrategia, SEO, publicidad y desarrollo web
					orientados a un único objetivo: tu crecimiento.
				</p>
				<ul class="mt-6 flex gap-3">
					{
						socials.map((social) => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={social.label}
									class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-text-2 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary-500/50 hover:text-primary-300"
								>
									<Icon name={social.icon} size={18} />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<nav aria-label="Navegación del pie">
				<h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text">
					Navegación
				</h3>
				<ul class="mt-5 space-y-3">
					{
						navigation.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-sm text-text-2 transition-colors hover:text-primary-300"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label="Servicios del pie">
				<h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text">
					Servicios
				</h3>
				<ul class="mt-5 space-y-3">
					{
						services.map((service) => (
							<li>
								<a
									href="#servicios"
									class="text-sm text-text-2 transition-colors hover:text-primary-300"
								>
									{service}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text">
					Contacto
				</h3>
				<ul class="mt-5 space-y-3 text-sm text-text-2">
					<li>
						<a
							href="mailto:hola@k2studio.es"
							class="transition-colors hover:text-primary-300"
						>
							hola@k2studio.es
						</a>
					</li>
					<li>
						<a href="tel:+34600000000" class="transition-colors hover:text-primary-300">
							+34 600 000 000
						</a>
					</li>
					<li>Madrid, España</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-14 flex flex-col gap-3 border-t border-border pt-8 text-sm text-text-3 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {year} K2 Studio. Todos los derechos reservados.</p>
			<p>Crecimiento medible, no promesas vacías.</p>
		</div>
	</div>
</footer>
