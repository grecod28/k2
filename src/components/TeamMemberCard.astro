---
interface Props {
	photo: string;
	name: string;
	role: string;
	tags?: string[];
	class?: string;
}

const { photo, name, role, tags = [], class: className } = Astro.props;
---

<figure
	class={[
		'group relative overflow-hidden rounded-3xl border border-border bg-surface-2',
		className
	]
		.filter(Boolean)
		.join(' ')}
>
	<div class="aspect-[4/5] overflow-hidden">
		<img
			src={photo}
			alt={`Fotografía de ${name}`}
			width="1583"
			height="1600"
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
		/>
	</div>

	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg via-bg/15 to-transparent transition-opacity duration-500"
		aria-hidden="true"
	></div>

	<span
		class="pointer-events-none absolute inset-0 rounded-3xl ring-1 ring-inset ring-transparent transition-all duration-500 group-hover:ring-primary-500/40"
		aria-hidden="true"
	></span>

	<figcaption class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 p-6 sm:p-8">
		<div>
			<h3 class="font-display text-2xl font-bold tracking-tight text-text">
				{name}
			</h3>
			<p class="mt-1 text-sm font-medium text-primary-300">
				{role}
			</p>
		</div>
		{
			tags.length > 0 && (
				<ul
					class="flex translate-y-2 flex-wrap gap-2 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 max-lg:translate-y-0 max-lg:opacity-100"
				>
					{
						tags.map((tag) => (
							<li
								class="rounded-full border border-border-strong bg-bg/70 px-3 py-1 text-xs font-medium text-text-2 backdrop-blur-sm"
							>
								{tag}
							</li>
						))
					}
				</ul>
			)
		}
	</figcaption>
</figure>
