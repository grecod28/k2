---
interface Props {
	photo: string;
	name: string;
	width: number;
	height: number;
	class?: string;
}

const { photo, name, width, height, class: className } = Astro.props;
---

<figure
	class={[
		'group relative overflow-hidden rounded-3xl border border-border bg-surface-2',
		className
	]
		.filter(Boolean)
		.join(' ')}
>
	<div class="aspect-[4/5] overflow-hidden">
		<img
			src={photo}
			alt={`Fotografía de ${name}`}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
		/>
	</div>

	<div
		class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/40 via-transparent to-transparent transition-opacity duration-500"
		aria-hidden="true"
	></div>

	<span
		class="pointer-events-none absolute inset-0 rounded-3xl ring-1 ring-inset ring-transparent transition-all duration-500 group-hover:ring-primary-500/40"
		aria-hidden="true"
	></span>
</figure>
