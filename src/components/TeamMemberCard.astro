---
interface Props {
  photo: string;
  name: string;
  width: number;
  height: number;
  class?: string;
}

const { photo, name, width, height, class: className } = Astro.props;
---

<figure
  class={[
    "card-ring group relative overflow-hidden rounded-3xl border border-border bg-surface-2",
    className,
  ]
    .filter(Boolean)
    .join(" ")}
>
  <div class="aspect-[4/5] overflow-hidden">
    <img
      src={photo}
      alt={`Fotografía de ${name}`}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
    />
  </div>

  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/55 via-transparent to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-100"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between p-5"
    aria-hidden="true"
  >
    <span class="rounded-full border border-white/10 bg-bg/50 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-text-2 backdrop-blur">
      K2 Studio
    </span>
    <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-bg/50 text-text-2 backdrop-blur">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </span>
  </div>

  <span
    class="pointer-events-none absolute inset-0 rounded-3xl ring-1 ring-inset ring-transparent transition-all duration-500 group-hover:ring-primary-500/40"
    aria-hidden="true"
  ></span>
</figure>
