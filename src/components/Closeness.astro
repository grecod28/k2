---
import Icon from "./Icon.astro";

const audienceWords = [
  "Pequeños negocios",
  "Comercios",
  "Restaurantes",
  "Profesionales",
  "Negocios familiares",
  "Startups",
];
---

<section id="cercania" class="relative overflow-hidden py-24 lg:py-32">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-[-6%] top-[20%] h-96 w-96 rounded-full bg-[radial-gradient(circle_at_center,var(--color-gold-500),transparent_70%)] opacity-[0.09] blur-3xl"></div>
    <div class="absolute bottom-[10%] right-[-8%] h-80 w-80 rounded-full bg-[radial-gradient(circle_at_30%_40%,var(--color-surface-2),var(--color-bg)_70%)]"></div>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
    <div>
      <p class="eyebrow" data-reveal>
        Cercanía
      </p>
      <h2
        class="section-title mt-4 font-display text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        De casa
        <br />
        <span class="text-gradient">para los de casa.</span>
      </h2>
      <p
        class="mt-6 max-w-md text-base leading-relaxed text-text-2 sm:text-lg"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        Ayudamos a pequeños negocios a dar el salto al mundo digital. Hablamos
        con las personas detrás de cada negocio y creamos soluciones a su
        medida. Sin humo, sin fórmulas genéricas.
      </p>
      <blockquote
        class="mt-8 max-w-md border-l-2 border-gold-500 pl-4 text-base italic leading-relaxed text-text-2"
        data-reveal
        style="--reveal-delay: 300ms"
      >
        No somos una gran corporación. Somos personas que trabajan con personas.
      </blockquote>

      <ul
        class="mt-8 flex flex-wrap gap-2"
        data-reveal
        style="--reveal-delay: 400ms"
      >
        {audienceWords.map((word) => (
          <li class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-2">
            {word}
          </li>
        ))}
      </ul>
    </div>

    <div
      class="relative mx-auto w-full max-w-xs sm:max-w-sm"
      data-reveal="zoom"
      style="--reveal-delay: 200ms"
    >
      <div class="relative flex flex-col gap-6" aria-hidden="true">
        <div class="absolute left-1/2 top-16 bottom-16 w-px -translate-x-1/2 bg-gradient-to-b from-border via-gold-500/40 to-primary-500/50"></div>

        <div class="spotlight card-ring relative flex flex-col items-center rounded-2xl border border-border bg-surface px-6 py-8 text-center shadow-[0_24px_60px_-40px_rgb(0_0_0/1)]">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-2 text-gold-400">
            <Icon name="home" size={20} />
          </span>
          <p class="mt-3 font-display text-base font-semibold text-text">
            Tu negocio
          </p>
          <p class="mt-1 text-xs text-text-3">Identidad propia</p>
        </div>

        <div class="spotlight card-ring relative flex flex-col items-center rounded-2xl border border-primary-500/30 bg-gradient-to-b from-primary-500/10 to-surface px-6 py-8 text-center shadow-[0_24px_60px_-32px_var(--color-primary-500)]">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-primary-500/40 bg-primary-500/10 text-primary-400">
            <Icon name="home" size={20} />
          </span>
          <p class="mt-3 font-display text-base font-semibold text-text">
            K2 Studio
          </p>
          <p class="mt-1 text-xs text-text-3">El mismo equipo</p>
        </div>

        <span
          class="absolute -right-4 top-1/2 flex -translate-y-1/2 animate-float items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-xs font-medium text-text-2 shadow-lg"
          style="animation-delay: 1.6s"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-secondary-400"></span>
          Hecho a medida
        </span>
      </div>
    </div>
  </div>
</section>
