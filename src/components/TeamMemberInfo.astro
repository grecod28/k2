---
interface Props {
  name: string;
  role: string;
  tags?: string[];
  description: string;
  quote: string;
}

const { name, role, tags = [], description, quote } = Astro.props;
---

<div class="max-w-lg">
  <h3
    class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl"
    data-reveal
    style="--reveal-delay: 100ms"
  >
    {name}
  </h3>
  <p
    class="mt-3 inline-flex items-center gap-2 rounded-full border border-primary-500/30 bg-primary-500/5 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-primary-300"
    data-reveal
    style="--reveal-delay: 180ms"
  >
    <span
      class="h-1.5 w-1.5 rounded-full bg-primary-400"
      aria-hidden="true"
    ></span>
    {role}
  </p>

  {tags.length > 0 && (
    <ul
      class="mt-5 flex flex-wrap gap-2"
      data-reveal
      style="--reveal-delay: 260ms"
    >
      {tags.map((tag) => (
        <li class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-2 transition-colors duration-300 hover:border-border-strong hover:text-text">
          {tag}
        </li>
      ))}
    </ul>
  )}

  <p
    class="mt-6 text-sm leading-relaxed text-text-2 sm:text-base"
    data-reveal
    style="--reveal-delay: 340ms"
  >
    {description}
  </p>

  <blockquote
    class="relative mt-7 rounded-r-xl border-l-2 border-gold-500 bg-gradient-to-r from-gold-500/[0.06] to-transparent py-2 pl-5 text-base italic leading-relaxed text-text-2"
    data-reveal
    style="--reveal-delay: 420ms"
  >
    <span
      class="pointer-events-none absolute -left-1 -top-3 font-display text-4xl leading-none text-gold-500/40"
      aria-hidden="true"
    >
      “
    </span>
    {quote}
  </blockquote>
</div>
